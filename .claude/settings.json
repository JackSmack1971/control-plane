{
  "hooks": {
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "command": "python .claude/hooks/instructions_loaded.py",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "session_start|nested_traversal|path_glob_match|include|compact"
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "python .claude/hooks/post_compact.py",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python .claude/hooks/record_mutation.py",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "python .claude/hooks/record_mutation.py",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "python .claude/hooks/record_failure.py",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "python .claude/hooks/pre_compact.py",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python .claude/hooks/guard_write.py",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "python .claude/hooks/guard_write.py",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "python .claude/hooks/session_end.py",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python .claude/hooks/validate_dirty_state.py",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "python .claude/hooks/validate_dirty_state.py",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(rg*)",
      "Bash(Get-Content*)",
      "Bash(python .claude/control-plane/scripts/generate_policy.py --check*)",
      "Bash(python .claude/control-plane/scripts/validate.py*)",
      "Bash(python -m pytest*)",
      "Bash(ruff check*)"
    ],
    "ask": [
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/agents/**)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/rules/**)",
      "Edit(./.claude/skills/**)",
      "Edit(./.claude/workflows/**)",
      "Edit(./.claude/control-plane/**)"
    ],
    "defaultMode": "default",
    "deny": [
      "Read(./.git/**)",
      "Edit(./.git/**)",
      "Read(./credentials/**)",
      "Edit(./credentials/**)",
      "Read(./docs/claude-code-docs/**)",
      "Edit(./docs/claude-code-docs/**)",
      "Read(./secrets/**)",
      "Edit(./secrets/**)",
      "WebFetch",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(Invoke-WebRequest*)"
    ]
  }
}
