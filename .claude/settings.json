{
  "hooks": {
    "PreToolUse": [
      {"matcher": "Edit|Write|NotebookEdit", "hooks": [{"type": "command", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\guard_write.py\"", "timeout": 3}]},
      {"matcher": "Bash", "hooks": [
        {"type": "command", "if": "Bash(rm *)", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\guard_write.py\"", "timeout": 3},
        {"type": "command", "if": "Bash(mv *)", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\guard_write.py\"", "timeout": 3},
        {"type": "command", "if": "Bash(cp *)", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\guard_write.py\"", "timeout": 3},
        {"type": "command", "if": "Bash(git apply *)", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\guard_write.py\"", "timeout": 3},
        {"type": "command", "if": "Bash(git config *)", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\guard_write.py\"", "timeout": 3},
        {"type": "command", "if": "Bash(python *)", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\guard_write.py\"", "timeout": 3},
        {"type": "command", "if": "Bash(powershell *Set-Content*)", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\guard_write.py\"", "timeout": 3}
      ]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write|NotebookEdit", "hooks": [{"type": "command", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\record_mutation.py\"", "timeout": 3}]},
      {"matcher": "Bash", "hooks": [
        {"type": "command", "if": "Bash(rm *)", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\record_mutation.py\"", "timeout": 3},
        {"type": "command", "if": "Bash(mv *)", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\record_mutation.py\"", "timeout": 3},
        {"type": "command", "if": "Bash(cp *)", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\record_mutation.py\"", "timeout": 3},
        {"type": "command", "if": "Bash(git apply *)", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\record_mutation.py\"", "timeout": 3},
        {"type": "command", "if": "Bash(git config *)", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\record_mutation.py\"", "timeout": 3},
        {"type": "command", "if": "Bash(python *)", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\record_mutation.py\"", "timeout": 3}
      ]}
    ],
    "PostToolUseFailure": [{"matcher": "*", "hooks": [{"type": "command", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\record_failure.py\"", "timeout": 3}]}],
    "Stop": [{"hooks": [{"type": "command", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\validate_dirty_state.py\"", "timeout": 5}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\validate_dirty_state.py\"", "timeout": 5}]}],
    "InstructionsLoaded": [{"matcher": "session_start|nested_traversal|path_glob_match|include|compact", "hooks": [{"type": "command", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\instructions_loaded.py\"", "timeout": 3}]}],
    "PreCompact": [{"matcher": "manual|auto", "hooks": [{"type": "command", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\pre_compact.py\"", "timeout": 3}]}],
    "PostCompact": [{"matcher": "manual|auto", "hooks": [{"type": "command", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\post_compact.py\"", "timeout": 3}]}],
    "SessionEnd": [{"matcher": "*", "hooks": [{"type": "command", "shell": "powershell", "command": "& python \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\session_end.py\"", "timeout": 3}]}]
  }
}
