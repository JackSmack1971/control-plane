{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-plane.local/schemas/baseline.schema.json",
  "title": "Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline_id", "created_at", "repository_revision", "manifest_hash", "lifecycle", "files", "content_hash"],
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "timestamp": {"type": "string", "format": "date-time"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "properties": {"baseline_id": {"$ref": "#/$defs/id"}, "created_at": {"$ref": "#/$defs/timestamp"}, "repository_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "manifest_hash": {"$ref": "#/$defs/hash"}, "lifecycle": {"enum": ["active", "superseded", "invalid"]}, "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "exists", "sha256", "mode", "owner", "generated"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"}, "exists": {"type": "boolean"}, "sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "mode": {"anyOf": [{"type": "string", "pattern": "^[0-7]{3}$"}, {"type": "null"}]}, "owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}, "generated": {"type": "boolean"}}}}, "content_hash": {"$ref": "#/$defs/hash"}}
}
