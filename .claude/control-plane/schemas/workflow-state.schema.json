{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-plane.local/schemas/workflow-state.schema.json",
  "title": "Workflow State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "run_id", "updated_at", "lifecycle", "state", "recovery", "content_hash"],
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "timestamp": {"type": "string", "format": "date-time"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "properties": {"schema_version": {"const": "1.0"}, "workflow_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "updated_at": {"$ref": "#/$defs/timestamp"}, "lifecycle": {"enum": ["active", "terminal"]}, "state": {"enum": ["planned", "validating", "verifying", "awaiting-approval", "verified", "rejected", "rolled-back"]}, "recovery": {"type": "object", "additionalProperties": false, "required": ["checkpoint", "evidence_paths", "details"], "properties": {"checkpoint": {"type": "string", "minLength": 1, "maxLength": 200}, "evidence_paths": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"}}, "details": {"type": "object", "maxProperties": 20, "additionalProperties": {"type": "string", "maxLength": 500}}}}, "content_hash": {"$ref": "#/$defs/hash"}},
  "allOf": [{"if": {"properties": {"lifecycle": {"const": "terminal"}}}, "then": {"properties": {"state": {"enum": ["verified", "rejected", "rolled-back"]}}}}, {"if": {"properties": {"lifecycle": {"const": "active"}}}, "then": {"properties": {"state": {"enum": ["planned", "validating", "verifying", "awaiting-approval"]}}}}]
}
