{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-plane.local/schemas/change-plan.schema.json",
  "title": "Change Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "run_id", "created_at", "writer_id", "lifecycle", "mode", "transaction_class", "write_set", "baseline_id", "operations", "content_hash"],
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "timestamp": {"type": "string", "format": "date-time"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"}},
  "properties": {"plan_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "created_at": {"$ref": "#/$defs/timestamp"}, "writer_id": {"$ref": "#/$defs/id"}, "lifecycle": {"enum": ["draft", "validated", "verified", "rejected", "rolled-back"]}, "mode": {"const": "control-plane-maintenance"}, "transaction_class": {"enum": ["lightweight", "standard", "sensitive"]}, "write_set": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "baseline_id": {"$ref": "#/$defs/id"}, "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["propose", "validate", "verify", "generate"]}}, "content_hash": {"$ref": "#/$defs/hash"}}
}
