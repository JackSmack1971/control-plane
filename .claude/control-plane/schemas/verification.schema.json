{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-plane.local/schemas/verification.schema.json",
  "title": "Independent Verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["verification_id", "run_id", "verified_at", "verifier_id", "lifecycle", "deterministic_checks", "semantic_findings", "operations", "content_hash"],
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "timestamp": {"type": "string", "format": "date-time"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "properties": {
    "verification_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "verified_at": {"$ref": "#/$defs/timestamp"}, "verifier_id": {"$ref": "#/$defs/id"}, "lifecycle": {"enum": ["completed", "failed"]},
    "deterministic_checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "command", "status", "output_hash"], "properties": {"name": {"type": "string", "minLength": 1}, "command": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed"]}, "output_hash": {"$ref": "#/$defs/hash"}}}},
    "semantic_findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["finding_id", "severity", "summary"], "properties": {"finding_id": {"$ref": "#/$defs/id"}, "severity": {"enum": ["info", "warning", "error"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 500}}}}, "operations": {"type": "array", "items": {"enum": ["read", "validate", "verify"]}, "minItems": 3, "maxItems": 3, "uniqueItems": true}, "content_hash": {"$ref": "#/$defs/hash"}
  }
}
