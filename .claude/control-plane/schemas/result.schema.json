{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-plane.local/schemas/result.schema.json",
  "title": "Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "run_id", "completed_at", "lifecycle", "terminal_result", "verification_id", "content_hash"],
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "timestamp": {"type": "string", "format": "date-time"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "properties": {"result_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "completed_at": {"$ref": "#/$defs/timestamp"}, "lifecycle": {"const": "terminal"}, "terminal_result": {"enum": ["verified", "rejected", "rolled-back"]}, "verification_id": {"$ref": "#/$defs/id"}, "content_hash": {"$ref": "#/$defs/hash"}}
}
