{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-plane.local/schemas/trust-anchor.schema.json",
  "title": "Recovery Trust Anchor",
  "type": "object",
  "additionalProperties": false,
  "required": ["anchor_id", "created_at", "lifecycle", "repository_revision", "manifest_hash", "last_event_hash", "content_hash"],
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "timestamp": {"type": "string", "format": "date-time"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "properties": {"anchor_id": {"$ref": "#/$defs/id"}, "created_at": {"$ref": "#/$defs/timestamp"}, "lifecycle": {"enum": ["active", "superseded"]}, "repository_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "manifest_hash": {"$ref": "#/$defs/hash"}, "last_event_hash": {"$ref": "#/$defs/hash"}, "content_hash": {"$ref": "#/$defs/hash"}}
}
